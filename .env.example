# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/abhijeet?retryWrites=true&w=majority

# Admin Auth (NextAuth Credentials)
ADMIN_EMAIL=admin@example.com
# Bcrypt hash (Note: in .env files, escape $ with \$ to avoid dotenv expansion, e.g. "\$2b\$10\$...")
ADMIN_PASSWORD_HASH="\$2b\$10\$t3EhFwCpymuA.b8.VM3I0Of.clDS8Gm6LiYym4amljTcOGUCKa99."

# NextAuth / Auth secret (generate with `openssl rand -base64 32`)
AUTH_SECRET=your-32-character-secret
NEXTAUTH_SECRET=your-32-character-secret
NEXTAUTH_URL=https://your-domain.vercel.app

# Email (Resend) - optional for inquiries notification
RESEND_API_KEY=re_123456789
CONTACT_TO_EMAIL=hello@abhijeet.example

# Public Site URL & SEO Indexation
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
# Set to 'true' for private demo (injects noindex, nofollow, disallow: /). Set to 'false' for public indexation.
NEXT_PUBLIC_NOINDEX=true